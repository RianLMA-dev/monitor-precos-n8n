    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const produto = $('Loop Over Products').item.json;\nconst html = $('Baixar Página do Produto').item.json.data || '';\nconst textoCss = $input.item.json.preco_texto || '';\n\nfunction toNumber(v) {\n  if (typeof v === 'number') return v;\n  const s = String(v || '').replace(/[^\\d,.-]/g, '');\n  if (!s) return NaN;\n  if (s.includes(',')) return parseFloat(s.replace(/\\./g, '').replace(',', '.'));\n  if (/^\\d{1,3}(\\.\\d{3})+$/.test(s)) return parseFloat(s.replace(/\\./g, ''));\n  return parseFloat(s);\n}\n\nfunction lerJsonLd(h) {\n  const m = h.match(/\"@type\"\\s*:\\s*\"Offer\"[^}]*?\"price\"\\s*:\\s*\"?([\\d.,]+)\"?/);\n  return m ? m[1] : '';\n}\n\n// Ordem de tentativa: JSON-LD primeiro, CSS como alternativa.\n// Se a planilha tiver a coluna \"metodo\" com o valor \"css\", inverte a ordem.\nconst preferirCss = String(produto.metodo || '').toLowerCase() === 'css';\nconst tentativas = preferirCss\n  ? [['css', textoCss], ['jsonld', lerJsonLd(html)]]\n  : [['jsonld', lerJsonLd(html)], ['css', textoCss]];\n\nlet texto = '';\nlet fonte = '';\nfor (const [nome, valor] of tentativas) {\n  if (valor && !isNaN(toNumber(valor))) {\n    texto = valor;\n    fonte = nome;\n    break;\n  }\n}\n\nconst precoSite = toNumber(texto);\nconst ideal = toNumber(produto.preco_ideal);\nconst anterior = toNumber(produto.preco_promocao);\n\nconst erro = isNaN(precoSite);\nconst precoFinal = erro ? (isNaN(anterior) ? '' : anterior) : precoSite;\n\nlet status;\nif (erro) status = 'Erro na leitura';\nelse status = precoSite <= ideal ? 'Abaixo do ideal' : 'Acima do ideal';\n\nconst alerta = !erro && precoSite <= ideal && precoSite !== anterior;\n\nreturn {\n  json: {\n    nome: produto.nome,\n    url: produto.url,\n    preco_ideal: ideal,\n    preco_promocao: precoFinal,\n    status,\n    ultima_verificacao: new Date().toLocaleString('pt-BR', { timeZone: 'America/Fortaleza' }),\n    fonte_leitura: fonte,\n    erro,\n    alerta\n  }\n};"
      },
